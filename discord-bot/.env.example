# Token del bot de Discord (Discord Developer Portal > Bot > Token)
DISCORD_BOT_TOKEN=tu_token_aqui
# Client ID (Discord Developer Portal > OAuth2 > Client ID)
DISCORD_CLIENT_ID=tu_client_id

# ID del servidor (guild) principal
GUILD_ID=tu_servidor_id

# IDs de roles y canales
STAFF_ROLE_ID=id_rol_staff
TICKET_CATEGORY_ID=id_categoria_tickets

# URL base de tu web (sin / al final)
API_BASE_URL=http://localhost:3000

# (opcional) API Key si proteges los endpoints
# API_KEY=...
