# ══════════════════════════════════════════
# BLOXARAY — Ejemplo de Configuración
# ══════════════════════════════════════════
# Copia este archivo como .env y completa los valores

# ── Autenticación (NextAuth v5) ──
AUTH_SECRET=genera_un_secreto_con_npx_auth_secret
AUTH_DISCORD_ID=tu_discord_client_id
AUTH_DISCORD_SECRET=tu_discord_client_secret
ADMIN_IDS=tu_discord_user_id

# ── Base de Datos (SQLite) ──
DATABASE_URL="file:./prisma/dev.db"

# ── Mercado Pago ──
MERCADO_PAGO_ACCESS_TOKEN=APP_USR-tu_access_token
MERCADO_PAGO_PUBLIC_KEY=APP_USR-tu_public_key
# Webhook Secret: dashboard.mercadopago.com > Webhooks
MERCADO_PAGO_WEBHOOK_SECRET=

# ── Discord Webhook (Notificaciones) ──
# Crea un webhook en tu canal de Discord: Ajustes del Canal > Integraciones > Webhooks
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/tu_webhook_id/tu_webhook_token

# ── Pago manual (Yape / Plin / Binance) ──
# Visible en la página de checkout (público, necesario para que paguen)
NEXT_PUBLIC_YAPE_NUMBER=
NEXT_PUBLIC_YAPE_NAME=BLOXARAY
NEXT_PUBLIC_PLIN_NUMBER=
NEXT_PUBLIC_PLIN_NAME=BLOXARAY
NEXT_PUBLIC_BINANCE_ID=
NEXT_PUBLIC_BINANCE_NAME=BLOXARAY

# ── Vercel Blob Storage (para comprobantes en producción) ──
# Crea un store en Vercel Dashboard > Storage > Blob
BLOB_READ_WRITE_TOKEN=

# ── Site ──
NEXT_PUBLIC_SITE_URL=https://bloxaray.com
